# Production build config for the React frontend (Vite reads this during
# `npm run build`). Point VITE_API_BASE at the API Gateway HTTP API base URL
# printed as the `ApiBaseUrl` output of the SAM stack (template.yaml), then
# rebuild and redeploy dist/.
#
# No frontend code changes are needed — src/config.js already reads this and
# src/api.js prefixes every /api and /rest call with it (JWT bearer attached).
#
# Example (replace with your real API id / region):
VITE_API_BASE=https://REPLACE_WITH_API_ID.execute-api.us-east-1.amazonaws.com
